# ================================================================
# Gemini API Key Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
# ================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended models: gemini-flash-latest, gemini-3.8-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-latest

# Context Window Management Strategy: "sliding_window" or "summarization"
CONTEXT_STRATEGY=sliding_window

# Maximum messages kept in direct context window (for sliding_window or trigger for summarization)
MAX_CONTEXT_MESSAGES=10

# Server settings
PORT=8000
HOST=127.0.0.1
